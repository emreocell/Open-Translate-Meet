    "vendor:sync": "node scripts/vendor-assets.mjs --write"
  },
  "dependencies": {
    "@ricky0123/vad-web": "0.0.31",
    "livekit-client": "2.23.0",
    "onnxruntime-web": "1.29.0"
  },
  "devDependencies": {
    "playwright": "1.65.0"
  }
}

# Store as MEET_PRIVATE_DIR/.env, outside the document root. Never commit secrets.
# bin/init-config.php generates APP_SECRET. Process environment overrides this file.
# Values are literal: no shell expansion or interpolation. Quotes are optional.

# HTTPS is required except for localhost; APP_URL must have no path component.
APP_URL=http://localhost:8080
APP_NAME="Auto Translate Meeting"
APP_SECRET=
# Configure with php bin/set-admin.php
ADMIN_PASSWORD_HASH=""
# Installation-wide upper bound for room capacity.
MAX_PARTICIPANTS=8
TRUSTED_PROXIES=
JOIN_TOKEN_TTL=120
SESSION_TTL=28800

# Required for video meetings: LiveKit Cloud or self-hosted LiveKit.
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# Configure APP_URL/api/livekit-webhook.php in LiveKit for membership enforcement.
# Leave dedicated webhook credentials empty to use the LiveKit credentials above.
LIVEKIT_WEBHOOK_API_KEY=
LIVEKIT_WEBHOOK_API_SECRET=
WEBHOOK_MAX_AGE_SECONDS=86400
WEBHOOK_REQUESTS_PER_HOUR=10000

# Optional speech translation; verify the model supports audio + ephemeral tokens.
TRANSLATION_PROVIDER=none
GEMINI_MODEL=
GEMINI_API_KEY=
# Legacy GEMINI_KEY_1..8 also work. Respect each provider account's quotas.
TRANSLATION_LANGUAGES=tr,en,de,fr,es,it,nl,pt,pl,ru,ar,ja
TRANSLATION_MAX_SESSIONS=3
LIVE_SESSION_SECONDS=600
LIVE_TOKENS_PER_PERSON_HOUR=36
LIVE_TOKENS_PER_ROOM_HOUR=180
LIVE_TOKENS_PER_HOUR=500
# Optional estimate only; not a provider bill or hard spend cap.
ESTIMATED_AUDIO_COST_PER_MINUTE=0
ESTIMATED_COST_CURRENCY=USD
# Fixed usage-record window; reads do not extend retention.
USAGE_RETENTION_DAYS=30

# Optional text translation and summaries, independent from live speech.
TEXT_PROVIDER=none
TEXT_MODEL=
TEXT_API_KEY=
TEXT_BASE_URL=
AI_REQUESTS_PER_ROOM_HOUR=180
AI_REQUESTS_PER_HOUR=1000
TEXT_JSON_MODE=true
TRANSCRIPT_ENABLED=false
TRANSCRIPT_RETENTION_HOURS=24
TRANSCRIPT_MAX_ENTRIES=4000

# Optional booking: none = local availability; google = Google Calendar OAuth.
BOOKING_ENABLED=false
BOOKING_CALENDAR_PROVIDER=none
BOOKING_TIMEZONE=UTC
BOOKING_SLOT_MINUTES=30
BOOKING_NOTICE_HOURS=12
BOOKING_DAYS=21
BOOKING_PENDING_HOURS=48
BOOKING_RETENTION_DAYS=120
# ISO weekdays 1=Monday..7=Sunday, start/end local hours.
BOOKING_HOURS='{"1":[9,17],"2":[9,17],"3":[9,17],"4":[9,17],"5":[9,17]}'
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALENDAR_ID=primary

# Optional SMTP: PHPMailer is installed by Composer.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_ENCRYPTION=starttls
SMTP_ALLOW_INSECURE=false
SMTP_FROM=
SMTP_FROM_NAME=
BOOKING_OWNER_EMAIL=

# Data limits: sizes in bytes, times in seconds unless named hours.
FILE_TTL=86400
UPLOAD_ROOM_QUOTA=536870912
UPLOAD_TOTAL_QUOTA=5368709120
FFMPEG_BIN=/usr/bin/ffmpeg
FFPROBE_BIN=/usr/bin/ffprobe
# Optional server-to-server integration, at least 32 random characters.
INTEGRATION_SECRET=

# Public identity: keep credentials out of these values.
DEFAULT_LOCALE=en
DEFAULT_THEME=auto
BRAND_LOGO=assets/brand/mark.svg
BRAND_FAVICON=assets/brand/mark.svg
BRAND_ACCENT=#7ea6ff
CONTACT_EMAIL=
CONTACT_PHONE=
CONTACT_WEBSITE=
# Public link to the project source shown in the footer (optional).
SOURCE_URL=https://github.com/emreocell/Open-Translate-Meet
